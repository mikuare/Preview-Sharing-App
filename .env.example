# Where this server is reachable. Must match the OAuth redirect URIs you register.
BASE_URL=http://localhost:8787
PORT=8787

# Signs session cookies. Generate one with:  node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI:  {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers → New OAuth App
# Authorization callback URL:  {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local testing without OAuth apps: lets POST /auth/dev sign you in as any email.
# Leave unset on anything deployed.
ALLOW_DEV_LOGIN=

DB_FILE=data/shares.db
