# ─── Where the app lives ────────────────────────────────────────────────────
# BASE_URL is the origin this server answers on, and is what OAuth redirect
# URIs are built from. APP_ORIGIN is where people get sent after sign-in.
#
# Local:  the API runs on :8787 while Vite serves the editor on :5173.
# Vercel: both are the same origin, so set them to the same value.
BASE_URL=http://localhost:8787
APP_ORIGIN=http://localhost:5173
PORT=8787

# Signs session cookies. REQUIRED in production — the server refuses to boot
# without it. Generate one with:  node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=

# ─── Sign-in providers ──────────────────────────────────────────────────────
# Google: console.cloud.google.com → APIs & Services → Credentials
#         → Create OAuth client ID → Web application
#         Authorised redirect URI:  {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers → New OAuth App
#         Authorization callback URL:  {BASE_URL}/auth/github/callback
#         (a GitHub OAuth App allows exactly one callback URL, so register a
#          separate app for localhost and for production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local testing without OAuth apps: lets POST /auth/dev sign you in as any
# email. Ignored whenever NODE_ENV=production or the app runs on Vercel.
ALLOW_DEV_LOGIN=

# ─── Storage ────────────────────────────────────────────────────────────────
# Supabase project → Settings → API.
#   SUPABASE_URL              Project URL, e.g. https://abcdefgh.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY service_role secret — server only, never shipped
#                             to the browser. It bypasses RLS by design.
# The anon/publishable key is NOT used: the browser never talks to Supabase
# directly, and the tables have RLS on with no policies, so an anon key could
# not read them anyway.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=8000

# With Supabase unset, shares are stored in this local SQLite file instead.
DB_FILE=data/shares.db

# If Supabase is configured but unreachable, fall back to the local file and
# report the server as degraded. Defaults to on locally, off on Vercel (where
# the filesystem is ephemeral and a local write would silently lose data).
ALLOW_LOCAL_FALLBACK=

MAX_WORKSPACE_BYTES=2000000
